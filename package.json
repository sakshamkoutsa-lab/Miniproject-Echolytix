{
  "name": "echolytix",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Multimodal Assistive Communication Platform (Blink, Sign, Morse, Remote Camera, TTS)",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakshamkoutsa-lab/Miniproject-Echolytix.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:tunnel": "tsx server.ts --tunnel",
    "dev:https": "tsx server.ts --https",
    "dev:https:tunnel": "tsx server.ts --https --tunnel",
    "build": "vite build && node scripts/generate-redirects.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "selfsigned": "^5.5.0",
    "untun": "^0.2.2",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
